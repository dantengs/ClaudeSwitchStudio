="0,0,18,0"/><TextBlock Text="{Binding Status}" FontSize="{DynamicResource SubSize}" Foreground="{DynamicResource Green}"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="重命名" Tag="rename" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Content="打开文件夹" Tag="open" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Content="撤回新增" Tag="undo" CommandParameter="{Binding}" IsEnabled="{Binding CanUndo}" Margin="0,0,8,0"/><Button Content="上传到云端" Tag="cloud-upload" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Content="删除" Tag="delete" CommandParameter="{Binding}" Foreground="#E5484D"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid>
