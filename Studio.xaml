     <ScrollViewer x:Name="UsagePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="先看清缓存，再决定是否换号" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="对话原文在本机；提示词缓存位于模型服务端。复制会话无法搬走服务端缓存，跨组织续聊应按可能需要重建缓存来规划。" Style="{StaticResource Sub}" Margin="0,12,0,0" LineHeight="22"/><Border Background="{DynamicResource Tint}" Padding="14" CornerRadius="8" Margin="0,18,0,0"><TextBlock Text="以下均为对话文件中保存的历史统计，可能来自迁移前的账号。它不能证明目标账号当前命中缓存，也不是账单。" FontSize="{DynamicResource SubSize}" LineHeight="21"/></Border></StackPanel></Border><Grid Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="UsageSession" DisplayMemberPath="UsageLabel"/><Button x:Name="ReadUsageBtn" Grid.Column="1" Content="读取历史统计" Style="{StaticResource Primary}" Margin="10,0,0,0"/></Grid><TextBlock x:Name="UsageCaption" Text="选择一条对话，查看最近一次记录的请求用量。" Style="{StaticResource Sub}" Margin="0,0,0,15"/><UniformGrid Columns="2" Margin="0,0,-12,0"><Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="缓存读取 · tokens" Style="{StaticResource Sub}"/><TextBlock x:Name="UsageRead" Text="—" FontSize="32" Foreground="{DynamicResource Green}" Margin="0,10,0,3"/><TextBlock x:Name="UsageRatio" Text="上次请求中，从缓存读取的输入" Style="{StaticResource Sub}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="缓存写入 · tokens" Style="{StaticResource Sub}"/><TextBlock x:Name="UsageWrite" Text="—" FontSize="32" Margin="0,10,0,3"/><TextBlock Text="首次缓存或重建时记录的写入量" Style="{StaticResource Sub}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="未缓存输入 · tokens" Style="{StaticResource Sub}"/><TextBlock x:Name="UsageInput" Text="—" FontSize="32" Margin="0,10,0,3"/><TextBlock Text="与缓存读写分开统计" Style="{StaticResource Sub}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="模型输出 · tokens" Style="{StaticResource Sub}"/><TextBlock x:Name="UsageOutput" Text="—" FontSize="32" Margin="0,10,0,3"/><TextBlock Text="该次响应记录的输出量" Style="{StaticResource Sub}"/></StackPanel></Border></UniformGrid><TextBlock Text="节省上下文：长对话可先在 Claude 中执行 /compact，再迁移续聊。默认不自动换号、不发送预热请求。套餐额度和 API 费用需分别判断。" Style="{StaticResource Sub}" LineHeight="22" Margin="0,6,0,12"/><Button x:Name="CacheDocsBtn" Content="查看官方缓存说明  ↗" HorizontalAlignment="Left"/></StackPanel></ScrollViewer>
     <Grid x:Name="BackupsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="操作之前，先留一份完整副本" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="保存会话索引、原文、记忆和文件历史，并核验 SHA-256。请先完全退出 Claude。" Style="{StaticResource Sub}" Margin="0,10,18,0" LineHeight="21"/></StackPanel><Button x:Name="BackupBtn" Grid.Column="1" Content="创建完整备份" Style="{StaticResource Primary}" VerticalAlignment="Center"/></Grid></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="BackupEmpty" Text="还没有通过新界面创建的备份。首次迁移前的备份仍保留在原位置。" Style="{StaticResource Sub}" Margin="0,0,0,14"/><ItemsControl x:Name="BackupCards"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Reason}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Time}" Style="{StaticResource Sub}" Margin="0,7,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{Binding Files,StringFormat={}{0} 个文件}" FontSize="{DynamicResource SubSize}" Margin="0,0,18,0"/><TextBlock Text="{Binding Size}" FontSize="{DynamicResource SubSize}" Margin="0,0,18,0"/><TextBlock Text="{Binding Status}" FontSize="{DynamicResource SubSize}" Foreground="{DynamicResource Green}"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="打开文件夹" Tag="open" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Content="撤回新增" Tag="undo" CommandParameter="{Binding}" IsEnabled="{Binding CanUndo}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="阅读与本地记忆" FontSize="{DynamicResource CardTitleSize}" FontWeight="SemiBold"/><Grid Margin="0,18,0,16"><TextBlock Text="正文字号" VerticalAlignment="Center"/><ComboBox x:Name="FontSizeChoice" Width="180" HorizontalAlignment="Right"><ComboBoxItem Content="舒适 · 15" Tag="15"/><ComboBoxItem Content="大字 · 17" Tag="17"/><ComboBoxItem Content="特大 · 19" Tag="19"/></ComboBox></Grid><TextBlock Text="项目记忆按本地目录共享。当前页面只列出位置，不移动文件。" Style="{StaticResource Sub}" Margin="0,0,0,15"/><ItemsControl x:Name="MemoryCards"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12"><StackPanel><TextBlock Text="{Binding Project}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Style="{StaticResource Sub}" Margin="0,6,0,4"/><TextBlock Text="{Binding Files,StringFormat={}{0} 个记忆文件}" Style="{StaticResource Sub}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="外观" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,18,0,0"><StackPanel><TextBlock Text="浅色 / 深色"/><TextBlock Text="主题跟随你的选择，下次启动时恢复。" Style="{StaticResource Sub}" Margin="0,6,0,0"/></StackPanel><Button x:Name="SettingsThemeBtn" Content="切换主题  ◐" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="操作内核" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="基于 Claude Desktop Account Switcher。Rust 管理本地对话池与邮箱匹配；本地适配器处理账号与提供商配置，操作前检查进程并生成时间戳备份。" Style="{StaticResource Sub}" Margin="0,12,0,0" LineHeight="22"/><TextBlock x:Name="KernelPathLabel" FontFamily="Consolas" Style="{StaticResource Sub}" Margin="0,14,0,0"/><TextBlock x:Name="WatcherLabel" Text="自动切换：读取中" Style="{StaticResource Sub}" Margin="0,12,0,0"/><TextBlock Text="当前版本不自动换号、不发送预热请求。你仍在工作时，可以使用只读预览查看账号和会话池。" Style="{StaticResource Sub}" Margin="0,8,0,16"/><Button x:Name="OnboardingBtn" Content="重新查看新手指引" HorizontalAlignment="Left" Margin="0,0,0,12"/><Button x:Name="SettingsOriginalBtn" Content="查看操作与交接说明  ↗" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Claude Switch Studio  0.3.1 · 本地工作区" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="参考 CC Switch 与 Antigravity Tools 的卡片和状态布局。账号、对话与记忆在本机管理；推理仍通过你选择的提供商。" Style="{StaticResource Sub}" Margin="0,12,0,0" LineHeight="22"/><Button x:Name="InstallFolderBtn" Content="打开安装目录  ↗" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
